{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered contributor, admin, or super administrator profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "username": {
          "type": "string",
          "description": "Unique username",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name",
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin", "super_admin", "guest", "registered_user", "editor", "administrator"],
          "description": "User permission role (user, admin, super_admin)"
        },
        "disabled": {
          "type": "boolean",
          "description": "Whether the user account is restricted or disabled"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short author bio"
        },
        "articlesCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["id", "username", "email", "role"]
    },
    "Article": {
      "title": "Article",
      "description": "Comprehensive encyclopedia entry and research dossier",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique article document ID"
        },
        "title": {
          "type": "string",
          "description": "Article title",
          "minLength": 2,
          "maxLength": 250
        },
        "slug": {
          "type": "string",
          "description": "Unique URL-friendly slug",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "summary": {
          "type": "string",
          "description": "Lead summary paragraph",
          "minLength": 10,
          "maxLength": 2000
        },
        "pronunciation": {
          "type": "string",
          "maxLength": 100
        },
        "articleType": {
          "type": "string",
          "enum": ["person", "place", "science", "event", "technology", "organization", "general"]
        },
        "category": {
          "type": "string",
          "description": "Display category title"
        },
        "categorySlug": {
          "type": "string",
          "description": "Category slug for indexing"
        },
        "subCategory": {
          "type": "string",
          "description": "Subcategory name"
        },
        "authorId": {
          "type": "string",
          "description": "Author UID"
        },
        "author": {
          "type": "string",
          "description": "Author display name"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "pending_review", "changes_requested", "published", "rejected", "archived"]
        },
        "region": {
          "type": "string",
          "description": "Geographic regional categorization"
        },
        "moderationNotes": {
          "type": "string",
          "description": "Editorial feedback, change requests, or rejection rationale"
        },
        "reviewedBy": {
          "type": "string",
          "description": "Display name of reviewer/admin"
        },
        "reviewedById": {
          "type": "string",
          "description": "UID of reviewer/admin"
        },
        "reviewedAt": {
          "type": "string",
          "description": "Timestamp of editorial review decision"
        },
        "submittedAt": {
          "type": "string",
          "description": "Timestamp when submitted for review"
        },
        "viewCount": {
          "type": "number",
          "description": "Total view count"
        },
        "readingTimeMinutes": {
          "type": "number"
        },
        "featured": {
          "type": "boolean"
        },
        "popular": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["id", "title", "slug", "summary", "category", "categorySlug", "authorId", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Encyclopedia knowledge domain taxonomy",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "iconName": {
          "type": "string"
        },
        "articleCount": {
          "type": "number"
        }
      },
      "required": ["id", "name", "slug", "description", "iconName"]
    },
    "Revision": {
      "title": "Revision",
      "description": "Historical snapshot of an article edit and content history",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "articleId": {
          "type": "string"
        },
        "articleTitle": {
          "type": "string"
        },
        "articleSlug": {
          "type": "string"
        },
        "editorId": {
          "type": "string"
        },
        "editorName": {
          "type": "string"
        },
        "previousContent": {
          "type": "string"
        },
        "newContent": {
          "type": "string"
        },
        "changeSummary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "actionType": {
          "type": "string",
          "enum": ["draft_saved", "submission", "approval", "changes_requested", "rejection", "direct_edit", "restore"]
        },
        "moderationNotes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "articleId", "editorId", "newContent", "changeSummary"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative audit trail recording admin actions, role changes, and system configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "actorUid": {
          "type": "string"
        },
        "actorEmail": {
          "type": "string"
        },
        "actorRole": {
          "type": "string",
          "enum": ["user", "admin", "super_admin", "guest", "registered_user", "editor", "administrator"]
        },
        "action": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "targetType": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": ["id", "actorUid", "actorEmail", "actorRole", "action", "timestamp"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Global platform configurations and governance policies",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "siteName": {
          "type": "string"
        },
        "requirePeerReview": {
          "type": "boolean"
        },
        "allowPublicSubmissions": {
          "type": "boolean"
        },
        "announcementBanner": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "updatedBy": {
          "type": "string"
        }
      },
      "required": ["id"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User saved article reference",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "articleId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["userId", "articleId"]
    },
    "Report": {
      "title": "Report",
      "description": "Content moderation flag and feedback",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "articleId": {
          "type": "string"
        },
        "reporterId": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "resolved", "dismissed"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "articleId", "reporterId", "reason", "description", "status"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "User email subscription for periodic updates and declassified dispatches",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "type": "string",
          "enum": ["active", "unsubscribed"]
        },
        "source": {
          "type": "string"
        },
        "subscribedAt": {
          "type": "string"
        },
        "unsubscribedAt": {
          "type": "string"
        }
      },
      "required": ["id", "email", "status"]
    },
    "NewsletterCampaign": {
      "title": "NewsletterCampaign",
      "description": "Super Admin dispatched newsletter campaigns and delivery tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "previewText": { "type": "string" },
        "articleUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "recipientCount": { "type": "number" },
        "sentCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["draft", "sending", "completed", "partially_failed", "failed"]
        }
      },
      "required": ["id", "subject", "title", "content", "status"]
    },
    "Evidence": {
      "title": "Evidence",
      "description": "Primary document, forensic artifact, or corroborated record linked to claims and investigations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "investigationId": { "type": "string" },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "source": { "type": "string", "minLength": 2, "maxLength": 200 },
        "sourceUrl": { "type": "string" },
        "repository": { "type": "string" },
        "dateCollected": { "type": "string" },
        "evidenceType": {
          "type": "string",
          "enum": ["primary_document", "forensic_record", "eyewitness_testimony", "academic_peer_reviewed", "investigative_journalism", "official_depository", "public_disclosure", "hearsay_unverified"]
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["verified", "corroborated", "under_review", "disputed", "debunked", "unverified"]
        },
        "confidenceScore": { "type": "number" },
        "custodyChain": { "type": "string" },
        "description": { "type": "string" },
        "rawExcerpt": { "type": "string" },
        "verifiedBy": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "supportingClaimIds": { "type": "array", "items": { "type": "string" } },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "source", "evidenceType", "verificationStatus", "authorId"]
    },
    "Investigation": {
      "title": "Investigation",
      "description": "Structured investigation dossier containing leads, evidence chain, and verified claims",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 3, "maxLength": 250 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "subject": { "type": "string", "minLength": 2, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "status": {
          "type": "string",
          "enum": ["lead", "evidence_gathering", "claims_analysis", "verification", "in_review", "completed", "published", "archived"]
        },
        "leadOrigin": { "type": "string" },
        "articleId": { "type": "string" },
        "articleSlug": { "type": "string" },
        "leadInvestigator": { "type": "string" },
        "leadInvestigatorId": { "type": "string" },
        "findings": { "type": "string" },
        "methodology": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedById": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "slug", "subject", "summary", "status", "leadInvestigatorId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles with User, Admin, and Super Admin RBAC"
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Stores encyclopedia articles and investigation dossiers"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Taxonomy definitions and subcategories"
    },
    "/revisions/{revisionId}": {
      "schema": { "$ref": "#/entities/Revision" },
      "description": "Historical snapshots and article edits"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Comprehensive administrative audit logs"
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Global system settings, moderation flags, and permissions"
    },
    "/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User specific reading bookmarks"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Moderation and content violation reports"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter subscriber emails and dispatch preferences"
    },
    "/newsletter_campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/NewsletterCampaign" },
      "description": "Super admin newsletter campaigns and delivery records"
    },
    "/investigations/{investigationId}": {
      "schema": { "$ref": "#/entities/Investigation" },
      "description": "Investigation dossiers tracking leads, evidence collection, and claims verification"
    },
    "/evidence/{evidenceId}": {
      "schema": { "$ref": "#/entities/Evidence" },
      "description": "Primary sources, forensic records, and verified artifacts linked to claims"
    }
  }
}
