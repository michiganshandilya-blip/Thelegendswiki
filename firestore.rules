rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 0. GLOBAL SAFETY NET (DEFAULT DENY)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // HELPER FUNCTIONS & ROLE-BASED ACCESS CONTROL
    // ==========================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Designated Initial Super Admin Email & Database Record Matching
    function hasRootSuperAdminDoc() {
      return exists(/databases/$(database)/documents/users/super-admin-root-01);
    }

    function getRootSuperAdminDoc() {
      return get(/databases/$(database)/documents/users/super-admin-root-01).data;
    }

    function isMatchingExistingSuperAdminData() {
      return isAuthenticated() && (
        (hasUserDoc() && ('role' in getUserDoc()) && getUserDoc().role == 'super_admin') ||
        (hasRootSuperAdminDoc() &&
         ('email' in request.auth.token) &&
         getRootSuperAdminDoc().email == request.auth.token.email &&
         getRootSuperAdminDoc().role == 'super_admin' &&
         (!('disabled' in getRootSuperAdminDoc()) || getRootSuperAdminDoc().disabled == false))
      );
    }

    function isDesignatedSuperAdminEmail() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (
          request.auth.token.email in ['michiganshandilya@gmail.com', 'MichiganShandilya@gmail.com'] ||
          request.auth.token.email.matches('(?i:^michiganshandilya@gmail\\.com$)')
        )) ||
        (hasUserDoc() && ('email' in getUserDoc()) && (
          getUserDoc().email in ['michiganshandilya@gmail.com', 'MichiganShandilya@gmail.com'] ||
          getUserDoc().email.matches('(?i:^michiganshandilya@gmail\\.com$)')
        )) ||
        isMatchingExistingSuperAdminData()
      );
    }

    // Direct Bootstrapped Admin Verification
    function isBootstrappedAdmin() {
      return isAuthenticated() && (
        isDesignatedSuperAdminEmail() ||
        ('email' in request.auth.token && (
          request.auth.token.email in [
            'michiganshandilya@gmail.com',
            'editor@thelegendswiki.org',
            'admin@thelegendswiki.org',
            'thelegendswiki@gmail.com',
            'scholar@thelegendswiki.org'
          ] ||
          request.auth.token.email.matches('(?i:^(michiganshandilya@gmail\\.com|editor@thelegendswiki\\.org|admin@thelegendswiki\\.org|thelegendswiki@gmail\\.com|scholar@thelegendswiki\\.org)$)')
        )) ||
        (hasUserDoc() && ('email' in getUserDoc()) && (
          getUserDoc().email in [
            'michiganshandilya@gmail.com',
            'editor@thelegendswiki.org',
            'admin@thelegendswiki.org',
            'thelegendswiki@gmail.com',
            'scholar@thelegendswiki.org'
          ]
        ))
      );
    }

    function getUserRole() {
      return isDesignatedSuperAdminEmail() 
        ? 'super_admin' 
        : isBootstrappedAdmin()
        ? 'admin'
        : (hasUserDoc() && ('role' in getUserDoc()) ? getUserDoc().role : 'user');
    }

    function isUserDisabled() {
      return !isDesignatedSuperAdminEmail() &&
        hasUserDoc() &&
        ('disabled' in getUserDoc()) &&
        getUserDoc().disabled == true;
    }

    function isRegisteredUser() {
      return isAuthenticated() && !isUserDisabled();
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        isDesignatedSuperAdminEmail() ||
        isMatchingExistingSuperAdminData() ||
        request.auth.uid == 'super-admin-root-01' ||
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        (hasUserDoc() && ('role' in getUserDoc()) && getUserDoc().role == 'super_admin') ||
        getUserRole() == 'super_admin'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isBootstrappedAdmin() || (
        isRegisteredUser() && (
          getUserRole() == 'admin' ||
          getUserRole() == 'editor' ||
          getUserRole() == 'administrator'
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Public scholar registry & profile reading for author attribution & user discovery
      allow get, list: if true;

      // Creation of user records:
      // Super Admin, Admins, or authenticated self profile creation
      allow create: if isValidId(userId) && isAuthenticated() && (
        isSuperAdmin() ||
        isAdmin() ||
        (isOwner(userId) && (
          isDesignatedSuperAdminEmail() ||
          !request.resource.data.keys().hasAny(['role']) ||
          request.resource.data.get('role', 'user') in ['user', 'registered_user', 'guest']
        ))
      );

      // Updating profiles:
      // 1. Super Admin can manage all accounts, promote/demote between user/admin/super_admin.
      //    (Protected initial super admin account cannot be demoted below super_admin)
      // 2. Admin can promote/demote between 'user' and 'admin' and manage moderation status ('disabled')
      // 3. Regular users can update their own non-security profile fields
      allow update: if isValidId(userId) && isAuthenticated() && (
        // Super Admin permissions
        (isSuperAdmin() && (
          (!('email' in resource.data) || resource.data.email != 'michiganshandilya@gmail.com') ||
          request.resource.data.get('role', 'super_admin') == 'super_admin'
        )) ||
        // Admin permissions on regular users and admin curators
        (isAdmin() && (
          resource.data.get('role', 'user') != 'super_admin' &&
          (!('email' in resource.data) || resource.data.email != 'michiganshandilya@gmail.com') &&
          (request.resource.data.get('role', 'user') == 'user' || request.resource.data.get('role', 'user') == 'admin')
        )) ||
        // Self profile update by regular user
        (isOwner(userId) &&
          resource.data.get('disabled', false) != true &&
          request.resource.data.get('id', userId) == resource.data.get('id', userId) &&
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
          request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
        )
      );

      // Only Super Admin can delete user profile records
      allow delete: if isValidId(userId) && isAuthenticated() && (
        isSuperAdmin() && (
          (!('email' in resource.data) || resource.data.email != 'michiganshandilya@gmail.com')
        )
      );
    }

    // ==========================================
    // 2. ARTICLES COLLECTION
    // ==========================================
    match /articles/{articleId} {
      // All articles, drafts, and dossiers are readable by scholars and visitors
      allow get, list: if true;

      // Authenticated registered users can create drafts/articles. Admins can create in any state.
      allow create: if isValidId(articleId) && isRegisteredUser() && (
        request.resource.data.authorId == request.auth.uid ||
        isAdmin()
      );

      // Authors can update their own dossiers. Admins can update any dossier.
      allow update: if isValidId(articleId) && (
        isAdmin() ||
        (isRegisteredUser() && resource.data.authorId == request.auth.uid)
      );

      // Authors can delete their own dossiers. Admins can delete any dossier.
      allow delete: if isValidId(articleId) && (
        isAdmin() ||
        (isRegisteredUser() && resource.data.authorId == request.auth.uid)
      );
    }

    // ==========================================
    // 3. REVISIONS COLLECTION
    // ==========================================
    match /revisions/{revisionId} {
      allow get, list: if true;

      allow create: if isValidId(revisionId) && isRegisteredUser() && (
        request.resource.data.editorId == request.auth.uid ||
        isAdmin()
      );

      allow update: if false;

      allow delete: if isValidId(revisionId) && isAdmin();
    }

    // ==========================================
    // 4. ADMINISTRATIVE AUDIT LOGS
    // ==========================================
    match /audit_logs/{logId} {
      // Admins and Super Admins can read audit logs
      allow read: if isValidId(logId) && isAdmin();

      // System events and admin actions record audit log entries
      allow create: if isValidId(logId) && isAuthenticated() && (
        request.resource.data.actorUid == request.auth.uid ||
        isAdmin()
      );

      // Audit logs are strictly immutable
      allow update: if false;

      // Super Admin can purge or manage audit logs
      allow delete: if isValidId(logId) && isSuperAdmin();
    }

    // ==========================================
    // 5. SYSTEM SETTINGS
    // ==========================================
    match /system_settings/{settingId} {
      // System policies, announcement status, and approved regions are readable by all visitors
      allow read: if isValidId(settingId);

      // Super Admin or Administrator can modify system settings
      allow write: if isValidId(settingId) && (isSuperAdmin() || isAdmin());
    }

    // ==========================================
    // 6. CATEGORIES & TAXONOMY
    // ==========================================
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isValidId(categoryId) && isAdmin();
    }

    // ==========================================
    // 7. BOOKMARKS COLLECTION
    // ==========================================
    match /bookmarks/{bookmarkId} {
      allow read: if isValidId(bookmarkId) && isRegisteredUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(bookmarkId) && isRegisteredUser() && request.resource.data.userId == request.auth.uid;
      allow delete: if isValidId(bookmarkId) && isRegisteredUser() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ==========================================
    // 8. REPORTS COLLECTION
    // ==========================================
    match /reports/{reportId} {
      allow create: if isValidId(reportId) && isRegisteredUser() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isValidId(reportId) && (isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid));
      allow update: if isValidId(reportId) && isAdmin();
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // ==========================================
    // 9. INVESTIGATIONS COLLECTION
    // ==========================================
    match /investigations/{investigationId} {
      // Published investigations or linked to published articles are public.
      // Admins & super admins can read all. Authors can read their own.
      allow read: if isValidId(investigationId) && (
        resource.data.isPublished == true ||
        resource.data.status == 'published' ||
        resource.data.status == 'completed' ||
        isAdmin() ||
        (isAuthenticated() && resource.data.leadInvestigatorId == request.auth.uid)
      );

      // Registered users can submit leads or draft investigations. Admins can create in any state.
      allow create: if isValidId(investigationId) && isRegisteredUser() && (
        (request.resource.data.leadInvestigatorId == request.auth.uid &&
          (request.resource.data.status == 'lead' || request.resource.data.status == 'evidence_gathering')) ||
        isAdmin()
      );

      // Admins can update any investigation. Authors can update their own drafts/leads.
      allow update: if isValidId(investigationId) && (
        isAdmin() || (
          isRegisteredUser() &&
          resource.data.leadInvestigatorId == request.auth.uid &&
          request.resource.data.leadInvestigatorId == request.auth.uid &&
          resource.data.status != 'published'
        )
      );

      // Only admins or the author of a draft/lead can delete
      allow delete: if isValidId(investigationId) && (
        isAdmin() || (
          isRegisteredUser() &&
          resource.data.leadInvestigatorId == request.auth.uid &&
          resource.data.status == 'lead'
        )
      );
    }

    // ==========================================
    // 10. EVIDENCE COLLECTION
    // ==========================================
    match /evidence/{evidenceId} {
      // Evidence is readable by everyone if verified/corroborated, or by admins & author
      allow read: if isValidId(evidenceId) && (
        resource.data.verificationStatus == 'verified' ||
        resource.data.verificationStatus == 'corroborated' ||
        isAdmin() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid)
      );

      // Registered users can submit new evidence records
      allow create: if isValidId(evidenceId) && isRegisteredUser() && (
        request.resource.data.authorId == request.auth.uid ||
        isAdmin()
      );

      // Admins can verify/update all evidence. Authors can edit their own unverified submissions.
      allow update: if isValidId(evidenceId) && (
        isAdmin() || (
          isRegisteredUser() &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == request.auth.uid &&
          resource.data.verificationStatus == 'under_review'
        )
      );

      // Admins can delete evidence records
      allow delete: if isValidId(evidenceId) && (
        isAdmin() || (
          isRegisteredUser() &&
          resource.data.authorId == request.auth.uid &&
          resource.data.verificationStatus == 'under_review'
        )
      );
    }

    // ==========================================
    // 11. NEWSLETTER SUBSCRIBERS & CAMPAIGNS
    // ==========================================
    match /newsletter_subscribers/{subscriberId} {
      allow read: if isValidId(subscriberId) && isAdmin();
      allow create: if isValidId(subscriberId);
      allow update: if isValidId(subscriberId) && isAdmin();
      allow delete: if isValidId(subscriberId) && isSuperAdmin();
    }

    match /newsletter_campaigns/{campaignId} {
      allow read: if isValidId(campaignId) && isAdmin();
      allow write: if isValidId(campaignId) && isSuperAdmin();
    }
  }
}
