rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all undefined paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)');
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Article imagery location
    match /articles/{articleId}/images/{imageFile} {
      // Public read access for encyclopedia images
      allow read: if true;

      // Authenticated users can upload article media under 5MB with valid image MIME type
      allow write: if isAuthenticated() && isImage() && isUnder5MB();
    }

    // User profile avatar storage location
    match /avatars/{userId}/{imageFile} {
      // Public read access for avatars
      allow read: if true;

      // Users can only upload and modify their own profile avatar under 5MB with valid image MIME type
      allow write: if isAuthenticated() && request.auth.uid == userId && isImage() && isUnder5MB();
    }
  }
}

